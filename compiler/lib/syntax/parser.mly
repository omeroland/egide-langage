(* Égide grammar — Menhir implementation of spec/grammar/egide.ebnf.
   Seed subset (T-0001): file = module declaration, imports, top-level `let` of simple expressions.
   The AST (ast.mli) already covers the complete grammar (T-0008).
   Declarations: T-0009. Statements: T-0010. Expressions: T-0011. Patterns: T-0012. Errors: T-0013.
   Tokens are declared in tokens.mly (generated by tools/gen/tokens.py). *)

%{
open Ast

let span (s, e) = Egide_source.Span.of_lexing s e

(* LEX-042: the lexer only produces DURATION with one of the six unit names. *)
let duration_unit = function
  | "ns" -> Ns
  | "us" -> Us
  | "ms" -> Ms
  | "s" -> S
  | "min" -> Min
  | "h" -> H
  | u -> invalid_arg ("Parser.duration_unit: " ^ u)
%}

(* Node ids (T-1006) come from an explicit generator, supplied by the caller as the functor argument [Ids]: the
   parser has no global state. Each node's id is allocated when its production is reduced, so the numbering is a
   function of the parse alone. *)
%parameter <Ids : sig type file = Ast.file val fresh : unit -> Node_id.t end>

(* What avoids warning 67 (unused functor parameter in the generated parser.mli, an error in the dev profile, and
   the fix is not to silence it) is [type file = Ast.file] in the parameter signature above: Menhir then writes the
   start type as [Ids.file] in parser.mli, so the signature mentions [Ids]. Typing the start symbol [<Ids.file>] is
   the explicit form of what Menhir infers anyway; it is kept so that this does not depend on that inference. Every
   instantiation (Parse, tests) must supply [type file = Ast.file]. *)
%start <Ids.file> file

%%

(* Seed restriction (T-0008): imports come before declarations, as in the EBNF `file` production (SYN-002). *)
file:
  | m = module_decl NEWLINE imports = list(terminated(import_decl, NEWLINE))
    decls = list(terminated(top_decl, NEWLINE)) EOF
    { { module_path = m; imports; decls; span = span $loc } }

module_decl:
  | KW_MODULE p = path { p }

ident:
  | name = IDENT { ({ id = Ids.fresh (); name; span = span $loc } : ident) }

path:
  | segments = separated_nonempty_list(DOT, ident) { ({ id = Ids.fresh (); segments; span = span $loc } : path) }

import_decl:
  | KW_IMPORT p = path alias = option(preceded(KW_AS, ident))
    { { import = Import { path = p; form = (match alias with None -> Whole | Some a -> Alias_as a) };
        span = span $loc } }

top_decl:
  | KW_LET name = ident EQ value = expr
    { { id = Ids.fresh (); attrs = []; vis = Private; decl = Const { name; ty = None; value };
        span = span $loc } }

expr:
  | e = expr_desc { { id = Ids.fresh (); expr = e; span = span $loc } }

expr_desc:
  | i = INT { Lit (Int i) }
  | f = FLOAT { Lit (Float f) }
  | d = DURATION { let amount, unit = d in Lit (Duration { amount; unit = duration_unit unit }) }
  | s = STRING { Lit (String s) }
  | KW_TRUE { Lit (Bool true) }
  | KW_FALSE { Lit (Bool false) }
  | p = path { Path p }
