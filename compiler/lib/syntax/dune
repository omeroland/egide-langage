(library
 (name egide_syntax)
 (public_name egide.syntax)
 (libraries egide.source egide.diagnostics menhirLib sedlex)
 (preprocess
  (pps sedlex.ppx)))

; tokens.mly and token_table.ml are generated by tools/gen/tokens.py (committed; CI checks they are fresh).
(menhir
 (modules tokens)
 (flags --only-tokens))

(menhir
 (modules tokens parser)
 (merge_into parser)
 (flags --external-tokens Tokens --unused-tokens --explain))
