(library
 (name egide_syntax)
 (public_name egide.syntax)
 (libraries
  egide.source
  egide.diagnostics
  menhirLib
  sedlex
  ppx_deriving.runtime)
 (preprocess
  (pps sedlex.ppx ppx_deriving.show ppx_deriving.eq)))

; tokens.ml, token_decls.mly and token_table.ml are generated by tools/gen/tokens.py (committed; CI checks they are
; fresh). tokens.ml is generated rather than written by Menhir (--only-tokens) because the TEMPLATE token holds
; tokens (LEX-055): the type is recursive.

(menhir
 (modules token_decls parser)
 (merge_into parser)
 (flags --external-tokens Tokens --unused-tokens --explain))
