{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omeroland/egide-langage/blob/main/docs/diagnostics.schema.json",
  "title": "Égide diagnostic",
  "description": "One object per diagnostic, printed on one line by `egide --error-format=json` (TOOL-040, TOOL-042; catalogue in docs/diagnostics.md). Lines and columns are 1-based, columns count Unicode scalar values, and `end` is exclusive. Validated by compiler/test/diagnostics/test_json.ml.",
  "type": "object",
  "required": ["code", "severity", "rule", "message", "span", "labels", "notes", "fixes"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "Stable code from the catalogue: E0001… errors, W0001… warnings, ICE for internal compiler errors.",
      "type": "string",
      "pattern": "^([EW][0-9]{4}|ICE)$"
    },
    "severity": { "enum": ["error", "warning"] },
    "rule": {
      "description": "Spec rule enforced, e.g. MEM-021; null only for internal compiler errors.",
      "type": ["string", "null"],
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "message": { "description": "One-line message.", "type": "string", "minLength": 1 },
    "span": { "$ref": "#/$defs/span" },
    "labels": {
      "description": "Secondary labelled spans.",
      "type": "array",
      "items": { "$ref": "#/$defs/label" }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fixes": {
      "description": "Suggested fixes as machine-applicable edits.",
      "type": "array",
      "items": { "$ref": "#/$defs/fix" }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": ["line", "col"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "col": { "description": "Counts Unicode scalar values.", "type": "integer", "minimum": 1 }
      }
    },
    "span": {
      "type": "object",
      "required": ["file", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "start": { "$ref": "#/$defs/position" },
        "end": { "description": "Exclusive.", "$ref": "#/$defs/position" }
      }
    },
    "label": {
      "type": "object",
      "required": ["span", "message"],
      "additionalProperties": false,
      "properties": {
        "span": { "$ref": "#/$defs/span" },
        "message": { "type": "string" }
      }
    },
    "edit": {
      "description": "Replace the text of `span` by `replacement`; an empty span inserts, an empty replacement deletes.",
      "type": "object",
      "required": ["span", "replacement"],
      "additionalProperties": false,
      "properties": {
        "span": { "$ref": "#/$defs/span" },
        "replacement": { "type": "string" }
      }
    },
    "fix": {
      "type": "object",
      "required": ["message", "edits"],
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edit" } }
      }
    }
  }
}
