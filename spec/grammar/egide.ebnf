(* Égide grammar — version 0.3-draft. Normative together with spec/03-syntax.md.
   Notation: ISO/IEC 14977 EBNF; { x } = zero or more, [ x ] = optional, "…" = terminal.
   Terminals in UPPER CASE come from the lexer (spec/02-lexical-structure.md):
   IDENT INT FLOAT DURATION STRING RAW_STRING BYTES CHAR TEMPLATE NEWLINE INDENT DEDENT EOF.
   `_` is the IDENT `_` (LEX-020). Comments, including `##` documentation comments, produce no token (LEX-031).
   Layout contract (LEX-036): every logical line ends with NEWLINE, except a line whose last token is a block `:`,
   which is followed by INDENT; DEDENT is never followed by NEWLINE. A block therefore ends with DEDENT, and a
   single-line block ends with the NEWLINE of its line.
   The grammar is LR(1) and is implemented with Menhir (compiler/lib/syntax/parser.mly). Where a production is
   marked COVER, the parser reads a larger language and a post-parse check rejects the excess with the diagnostic
   named in spec/03-syntax.md (SYN-005). Operator precedence is given by SYN-100 and expressed in the productions. *)

file            = module_decl NEWLINE { import_decl NEWLINE } { top_decl } EOF ;

module_decl     = "module" path ;
path            = IDENT { "." IDENT } ;

import_decl     = "import" path [ "." "{" import_item { "," import_item } [ "," ] "}" | "as" IDENT ]
                | "import" "go" STRING "as" IDENT ;
import_item     = IDENT [ "as" IDENT ] ;

(* ---------- Declarations ---------- *)

top_decl        = { attribute NEWLINE } ( [ visibility ] item_decl | impl_decl ) ;
item_decl       = fn_decl | struct_decl | enum_decl | trait_decl | type_decl NEWLINE | const_decl ;
visibility      = "pub" [ "(" IDENT ")" ] ;                 (* the IDENT MUST be `package`, SYN-003 *)
attribute       = "@" IDENT [ "(" [ expr_list ] ")" ] ;

fn_decl         = fn_sig ":" suite ;
fn_sig          = "fn" IDENT [ generics ] "(" [ params ] ")" [ "->" ret_type ] [ using_clause ] ;
params          = self_param { "," param } [ "," ] | param { "," param } [ "," ] ;
self_param      = [ "inout" | "take" ] "self" ;
param           = [ "inout" | "take" | "comptime" ] IDENT ":" type [ "=" expr ] ;
using_clause    = "using" cap_param { "," cap_param } ;
cap_param       = IDENT ":" type ;
generics        = "[" generic { "," generic } "]" ;
generic         = [ "comptime" ] IDENT [ ":" bound { "+" bound } ] ;
bound           = path [ "[" gen_args "]" ] ;                 (* traits and capabilities *)

struct_decl     = "struct" IDENT [ generics ]
                  ( ":" INDENT field NEWLINE { field NEWLINE } DEDENT | NEWLINE ) ;     (* NEWLINE: no fields, SYN-024 *)
field           = { attribute NEWLINE } [ visibility ] IDENT ":" type [ "=" expr ] ;

enum_decl       = "enum" IDENT [ generics ] ":" INDENT variant NEWLINE { variant NEWLINE } DEDENT ;
variant         = IDENT [ "(" variant_fields ")" ] ;
variant_fields  = type { "," type }                       (* positional *)
                | IDENT ":" type { "," IDENT ":" type } ;  (* named *)

trait_decl      = "trait" IDENT [ generics ] [ ":" bound { "+" bound } ] ":" INDENT
                  trait_item { trait_item } DEDENT ;
trait_item      = fn_sig NEWLINE | fn_decl | "type" IDENT [ ":" bound ] NEWLINE ;

impl_decl       = "impl" [ generics ] type ( ":" impl_body | "for" type ( ":" impl_body | NEWLINE ) ) ;
impl_body       = INDENT impl_item { impl_item } DEDENT ;
impl_item       = { attribute NEWLINE } [ visibility ] fn_decl | "type" IDENT "=" type NEWLINE ;

type_decl       = "type" IDENT [ generics ] "=" ( "new" type [ "where" expr ] | type ) ;
const_decl      = "let" IDENT [ ":" type ] "=" ( expr NEWLINE | block_expr ) ;    (* implicitly comptime, CT-002 *)

(* ---------- Types (SYN-042, TYP-006) ---------- *)

type            = ret_type | fn_type ;
ret_type        = simple_type [ "?" ] ;                   (* every type except an unparenthesised fn type *)
simple_type     = path [ "[" gen_args "]" ]
                | "(" ")" | "(" type ")" | "(" type "," [ type { "," type } [ "," ] ] ")"
                | "dyn" bound { "+" bound }
                | "Self" ;
fn_type         = "fn" "(" [ type { "," type } ] ")" [ "->" ret_type ] [ "using" fn_caps ] ;
fn_caps         = bound { "+" bound } ;                    (* capability types are nominal *)
gen_args        = gen_arg { "," gen_arg } [ "," ] ;
gen_arg         = expr | fn_type | "dyn" bound { "+" bound } ;

(* ---------- Blocks and statements (SYN-010 .. SYN-017, SYN-061) ---------- *)

suite           = single_stmt NEWLINE                        (* single-line block *)
                | INDENT stmt { stmt } DEDENT ;               (* indented block *)
stmt            = simple_stmt NEWLINE | block_stmt ;
single_stmt     = expr
                | assign_target assign_op expr
                | "return" [ expr ] | "break" [ expr ] | "continue"
                | "defer" expr | "yield" expr ;
simple_stmt     = single_stmt
                | "let" pattern [ ":" type ] "=" expr
                | "var" IDENT [ ":" type ] "=" expr
                | "comptime" "let" IDENT [ ":" type ] "=" expr ;
block_stmt      = block_expr
                | "let" pattern [ ":" type ] "=" ( block_expr | expr "else" ":" suite )
                | "var" IDENT [ ":" type ] "=" block_expr
                | assign_target assign_op block_expr
                | "for" pattern "in" expr ":" suite
                | "while" expr ":" suite ;
assign_target   = postfix_expr ;                             (* COVER: MUST be a place, SYN-012 (E0106) *)
assign_op       = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

(* Block-ended expressions (SYN-015): they end with a block, so nothing may follow them on their logical line. *)
block_expr      = if_expr | match_expr | loop_expr | with_expr | given_expr | fn_lambda | trailing_call
                | unsafe_expr ;
if_expr         = "if" expr ":" suite { "elif" expr ":" suite } [ "else" ":" suite ] ;
match_expr      = "match" expr ":" INDENT case_arm { case_arm } DEDENT ;
case_arm        = "case" pattern [ "if" expr ] ":" suite ;
loop_expr       = "loop" ":" suite ;
with_expr       = "with" with_item { "," with_item } ":" suite ;
with_item       = [ IDENT "=" ] expr ;
given_expr      = "given" expr { "," expr } ":" suite ;
fn_head         = "fn" [ "(" [ lambda_params ] ")" [ "->" ret_type ] ] ;
fn_lambda       = fn_head ":" suite ;
trailing_call   = postfix_expr "(" [ args ] ")" fn_head ":" suite ;      (* the call's own parentheses, SYN-062 *)
unsafe_expr     = "unsafe" "(" IDENT ":" STRING ")" ":" suite ;          (* COVER: the IDENT MUST be `reason`, SYN-017 *)
lambda_params   = lambda_param { "," lambda_param } ;
lambda_param    = [ "inout" | "take" ] IDENT [ ":" type ] ;

(* ---------- Expressions (precedence per SYN-100) ---------- *)

expr            = lambda | pipe_expr ;
lambda          = IDENT "=>" expr
                | paren_form "=>" expr ;                       (* COVER: every item is a lambda parameter, SYN-065 *)
pipe_expr       = cond_expr { "|>" cond_expr } ;               (* COVER: right side is a path or call, SYN-037 (E0108) *)
cond_expr       = or_expr [ "if" or_expr "else" cond_expr ] ;
or_expr         = and_expr { "or" and_expr } ;
and_expr        = not_expr { "and" not_expr } ;
not_expr        = "not" not_expr | cmp_expr ;
cmp_expr        = range_expr { cmp_op range_expr } ;
cmp_op          = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
range_expr      = bitor_expr [ ".." [ bitor_expr ] | "..=" bitor_expr ] | ".." [ bitor_expr ] | "..=" bitor_expr ;
bitor_expr      = bitxor_expr { "|" bitxor_expr } ;
bitxor_expr     = bitand_expr { "^" bitand_expr } ;
bitand_expr     = shift_expr { "&" shift_expr } ;
shift_expr      = add_expr { ( "<<" | ">>" ) add_expr } ;
add_expr        = mul_expr { ( "+" | "-" ) mul_expr } ;
mul_expr        = unary_expr { ( "*" | "/" | "%" ) unary_expr } ;
unary_expr      = ( "-" | "~" ) unary_expr | pow_expr ;
pow_expr        = postfix_expr [ "**" unary_expr ] ;

postfix_expr    = primary { "(" [ args ] ")" | "[" gen_args "]" | "." IDENT | "?" } ;
args            = arg { "," arg } [ "," ] ;
arg             = [ IDENT ":" ] ( expr | "&" postfix_expr )   (* COVER: after `&` a place, SYN-033 (E0106) *)
                | "using" IDENT ":" expr ;                    (* explicit capability, CAP-032 *)

primary         = literal | IDENT | "self" | "Self"
                | paren_form
                | "[" [ expr_list ] "]" | "[" expr comp_clauses "]"
                | "{" [ map_entries | expr_list ] "}" | "{" map_entry comp_clauses "}" | "{" expr comp_clauses "}" ;
paren_form      = "(" [ cover_list ] ")" | "(" expr comp_clauses ")" ;
cover_list      = cover_item { "," cover_item } [ "," ] ;     (* COVER, SYN-065: as an expression no mode, no `:` type *)
cover_item      = [ "inout" | "take" ] expr [ ":" type ] ;
expr_list       = expr { "," expr } [ "," ] ;
map_entries     = map_entry { "," map_entry } [ "," ] ;
map_entry       = expr ":" expr ;
comp_clauses    = comp_for { comp_for | "if" or_expr } ;
comp_for        = "for" pattern "in" or_expr ;

literal         = INT | FLOAT | DURATION | STRING | RAW_STRING | BYTES | CHAR | TEMPLATE | "true" | "false" ;

(* ---------- Patterns (SYN-050 .. SYN-053) ---------- *)

pattern         = or_pattern [ "as" IDENT ] ;
or_pattern      = simple_pattern { "|" simple_pattern } ;
simple_pattern  = literal_pattern | range_pattern
                | path [ "(" [ field_patterns ] ")" ]         (* SYN-053: a lone lowercase IDENT is a binding *)
                | "(" pattern "," [ pattern { "," pattern } [ "," ] ] ")"
                | "[" [ list_patterns ] "]" ;
literal_pattern = [ "-" ] ( INT | FLOAT | DURATION ) | STRING | RAW_STRING | BYTES | CHAR | "true" | "false" ;
range_pattern   = literal_pattern ( ".." | "..=" ) literal_pattern ;
field_patterns  = field_pattern { "," field_pattern } [ "," ] ;
field_pattern   = [ IDENT ":" ] pattern | ".." ;
list_patterns   = list_pattern { "," list_pattern } ;
list_pattern    = pattern | ".." [ IDENT ] ;
