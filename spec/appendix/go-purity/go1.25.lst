# go1.25.lst — Égide Go purity list (SEED — incomplete, see T-0040)
# <import path>[.<Receiver>].<Func> <class> [# note]
archive/zip.* pure
archive/zip.OpenReader fs
bufio.* pure
bytes.* pure
cmp.* pure
context.* pure
crypto/rand.* rand
crypto/rand.var.Reader rand
crypto/sha256.* pure
crypto/sha512.* pure
crypto/tls.* pure
crypto/tls.Dial net
crypto/tls.DialWithDialer net
crypto/tls.Listen net
crypto/tls.LoadX509KeyPair fs
encoding/base64.* pure
encoding/hex.* pure
encoding/json.* pure
errors.* pure
fmt.* pure
fmt.Print stdout
fmt.Printf stdout
fmt.Println stdout
fmt.Scan stdin
fmt.Scanf stdin
fmt.Scanln stdin
html/template.* pure
html/template.ParseFiles fs
html/template.ParseGlob fs
html/template.Template.Execute go
html/template.Template.ExecuteTemplate go
html/template.Template.ParseFiles fs
html/template.Template.ParseGlob fs
io.* pure
io.var.Discard pure
io.var.EOF pure
maps.* pure
math.* pure
mime.* pure
mime.AddExtensionType go
mime.ExtensionsByType fs
mime.TypeByExtension fs
net.* net
net/http.* net
net/netip.* pure
net/url.* pure
os.* go
os.var.Args env
os.var.Stderr stderr
os.var.Stdin stdin
os.var.Stdout stdout
os/exec.* proc
path.* pure
path/filepath.* pure
path/filepath.Abs fs
path/filepath.EvalSymlinks fs
path/filepath.Glob fs
path/filepath.Walk fs
path/filepath.WalkDir fs
plugin.* forbidden
reflect.* pure
reflect.NewAt forbidden
reflect.Value.Call go
reflect.Value.CallSlice go
reflect.Value.Interface go
reflect.Value.Method go
reflect.Value.MethodByName go
reflect.Value.Seq go
reflect.Value.Seq2 go
reflect.Value.UnsafePointer forbidden
regexp.* pure
slices.* pure
sort.* pure
strconv.* pure
strings.* pure
syscall.* forbidden
text/template.* pure
text/template.ParseFiles fs
text/template.ParseGlob fs
text/template.Template.Execute go
text/template.Template.ExecuteTemplate go
text/template.Template.ParseFiles fs
text/template.Template.ParseGlob fs
time.* pure
time.After clock
time.LoadLocation fs   # reads the zoneinfo database
time.NewTicker clock
time.NewTimer clock
time.Now clock
time.Since clock
time.Sleep clock
time.Tick clock
time.Until clock
time.var.Local clock
unicode.* pure
unicode/utf8.* pure
unsafe.* forbidden
