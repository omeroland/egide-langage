# go1.25.lst — Égide Go purity list (SEED — incomplete, see T-0040)
# <import path>[.<Receiver>].<Func> <class> [# note]
bufio.* pure
bytes.* pure
cmp.* pure
context.* pure
crypto/rand.* rand
crypto/sha256.* pure
crypto/sha512.* pure
encoding/base64.* pure
encoding/hex.* pure
encoding/json.* pure
errors.* pure
fmt.* pure
fmt.Print stdout
fmt.Printf stdout
fmt.Println stdout
fmt.Scan stdin
fmt.Scanf stdin
fmt.Scanln stdin
io.* pure
maps.* pure
math.* pure
net.* net
net/http.* net
net/netip.* pure
net/url.* pure
os.* go
os/exec.* proc
path.* pure
path/filepath.* pure
path/filepath.Abs fs
path/filepath.EvalSymlinks fs
path/filepath.Glob fs
path/filepath.Walk fs
path/filepath.WalkDir fs
plugin.* forbidden
regexp.* pure
slices.* pure
sort.* pure
strconv.* pure
strings.* pure
syscall.* forbidden
time.* pure
time.After clock
time.LoadLocation fs   # reads the zoneinfo database
time.NewTicker clock
time.NewTimer clock
time.Now clock
time.Since clock
time.Sleep clock
time.Tick clock
time.Until clock
unicode.* pure
unicode/utf8.* pure
unsafe.* forbidden
