# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.0.1"
synopsis: "Égide: a secure-by-default programming language"
description:
  "egidec, the bootstrap compiler and toolchain for the Égide language."
maintainer: ["Omeroland"]
authors: ["Omeroland" "The Égide contributors"]
license: "Apache-2.0"
homepage: "https://github.com/omeroland/egide-langage"
bug-reports: "https://github.com/omeroland/egide-langage/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.14" & >= "3.14"}
  "menhir" {>= "20231231"}
  "sedlex" {>= "3.2"}
  "ppx_expect" {with-test}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "ocamlformat" {with-dev-setup & = "0.28.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/omeroland/egide-langage.git"
